#VECTORSTORE_QDRANT_HOST
VECTORSTORE_QDRANT_PORT=6333
VECTORSTORE_QDRANT_GRPC_PORT=6334
VECTORSTORE_COLLECTION_nAME=my_documents
VECTORSTORE_EMBEDDING_MODEL=intfloat/multilingual-e5-base
VECTORSTORE_SPARSE_MODEL=Qdrant/bm25
