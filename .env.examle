SPLITTER_HEADERS_TO_SPLIT_ON='[["##","chapter"],["###","section"],["####","subsection"]]'
SPLITTER_CHUNK_SIZE=500
SPLITTER_CHUNK_OVERLAP=50
SPLITTER_MIN_CHUNK_LENGTH=3
SPLITTER_ALLOWED_EXTENSIONS=[".md"]

VECTORSTORE_QDRANT_PATH=./qdrant
VECTORSTORE_QDRANT_HOST=localhost
VECTORSTORE_CONNECTION_MODE=remote
VECTORSTORE_QDRANT_PORT=6333
VECTORSTORE_QDRANT_GRPC_PORT=6334
VECTORSTORE_COLLECTION_NAME=my_documents
VECTORSTORE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
VECTORSTORE_SPARSE_MODEL=Qdrant/bm25
VECTORSTORE_DENSE_VECTOR_SIZE=384
VECTORSTORE_DISTANCE=COSINE
VECTORSTORE_TOP_K=5
VECTORSTORE_SEARCH_TYPE="similarity"

GIGACHAT_CREDENTIALS="Your Gigachat credentials"